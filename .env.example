# Supabase project (create at https://supabase.com, then fill these in).
# Copy this file to .env.local (git-ignored) and never commit real values.

# Browser + SSR via @supabase/ssr — NEXT_PUBLIC_* is inlined into the client
# bundle at BUILD time, so these must be set before `npm run build`, not just
# `npm run start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never import into a Client Component.
SUPABASE_SECRET_KEY=

# @supabase/server (Edge Functions phase) reads these exact unprefixed names.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Cloudflare Turnstile (login form CAPTCHA). Sitekey is public by design —
# the Secret Key never enters this repo, it's pasted directly into Supabase
# dashboard → Auth → Bot and Abuse Protection. The login form renders no
# widget at all when this is unset (dev fallback, matches the
# isSupabaseConfigured pattern used elsewhere in lib/supabase/env.ts).
#
# For local dev, use one of Cloudflare's documented testing sitekeys instead
# of a real one — no Cloudflare account needed:
#   1x00000000000000000000AA  always passes, visible widget (recommended)
#   1x00000000000000000000BB  always passes, invisible widget
#   2x00000000000000000000AB  always blocks, visible widget
#   2x00000000000000000000BB  always blocks, invisible widget
#   3x00000000000000000000FF  forces an interactive challenge
# NEVER set a test key as the real production value — lib/turnstile.ts's
# assertTurnstileSafeForProduction() throws in production if it detects one
# (or if this is unset), specifically to prevent that.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Fallback for actions/auth.ts's emailRedirectTo/redirectTo when the
# `origin` request header is absent — without it, a missing header produces
# the literal string "null/th/auth/callback" instead of a real URL, and a
# signup/reset email's link goes nowhere. Set to the deployed origin, e.g.
# https://test-claude-swart-delta.vercel.app (no trailing slash).
#
# Can be left blank on Vercel: lib/site-url.ts falls back to Vercel's
# auto-injected VERCEL_PROJECT_PRODUCTION_URL. Only set this by hand for a
# custom domain, if "Automatically expose System Environment Variables" is
# off, or for the self-hosted Linux target (CLAUDE.md §2).
NEXT_PUBLIC_SITE_URL=

# Web Push (VAPID) — Settings > web push opt-in, and the send pipeline at
# app/api/push/dispatch (see docs/web-push.md for the Supabase webhook that
# drives it).
# Generate BOTH halves TOGETHER with `npx web-push generate-vapid-keys` and
# keep them together: the private key is the only thing that can ever send
# to a subscription created with the public one, so losing or rotating it
# permanently invalidates every subscription stored so far.
#
# Public half is inlined into the client bundle by design — it's the
# applicationServerKey the browser subscribes with, not a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only, never NEXT_PUBLIC_ — this is the signing key.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@udontech.ac.th

# Shared secret the Supabase Database Webhook presents to
# /api/push/dispatch as `x-push-secret`. That endpoint makes the server send
# notifications to real devices, so it is not public: without this set, every
# caller is rejected with 401 and nothing is ever sent. Generate with
# `openssl rand -base64 32`.
PUSH_DISPATCH_SECRET=

# Left unset in dev/CI on purpose: lib/push.ts#isPushConfigured hides the
# Settings toggle entirely when NEXT_PUBLIC_VAPID_PUBLIC_KEY is empty,
# same "hide rather than render a control that can only fail" pattern as
# isTurnstileConfigured/isSupabaseAdminConfigured. Deliberately NOT enforced
# by lib/env-guard.ts's production build guard — push is a progressive
# enhancement, not a required feature, so a missing key must not fail a
# production build the way a missing Supabase/Turnstile var does.

# --- Outbound email (SMTP) -------------------------------------------------
# The password-setup / password-reset link is sent by THIS APP, not by
# Supabase Auth (see docs/email-setup.md for why, and for how to get an App
# Password). Without these, that email is never sent — and since setting a
# password is the only way an account without one gets in, that is a real
# outage rather than a degraded feature, so lib/env-guard.ts DOES fail a
# production build when they are missing (unlike the VAPID keys above).
#
# Gmail / Google Workspace defaults; any SMTP provider works.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (secure). 587 = STARTTLS, also fine. Port 25 is blocked
# on most hosts including Vercel — do not use it.
SMTP_PORT=465
# The full mailbox address that authenticates, e.g. noreply@udontech.ac.th
SMTP_USER=
# A 16-character Google APP PASSWORD, not the account password. Requires
# 2-Step Verification to be enabled first; Google removed "less secure app
# access" in 2022, so there is no other username/password route.
SMTP_PASSWORD=
# The From header. Gmail rewrites or rejects a From that is neither the
# authenticated mailbox nor one of its verified "Send mail as" aliases, so
# this is not free text. A display name is optional:
#   SMTP_FROM="AFT UDONTECH <noreply@udontech.ac.th>"
SMTP_FROM=

# --- Turnstile secret (server-side verification) ------------------------------
# The app now calls Cloudflare's siteverify itself instead of letting Supabase
# do it (Supabase's project-level CAPTCHA must be turned OFF, or sign-in breaks
# — a Turnstile token is single-use and cannot be verified twice).
#
# Server-only: never NEXT_PUBLIC_. Required in production; lib/env-guard.ts
# fails the build without it.
#
# For local dev use one of Cloudflare's documented TEST SECRET keys — they pair
# with the test sitekeys above and need no Cloudflare account:
#   1x0000000000000000000000000000000AA  always passes
#   2x0000000000000000000000000000000AA  always fails
#   3x0000000000000000000000000000000AA  yields "token already spent"
TURNSTILE_SECRET_KEY=

# Optional. Extra hostnames siteverify may report, comma-separated. Normally
# unnecessary: the check compares against the current request's own host, so
# new domains and Vercel preview URLs work with no configuration. Set this only
# for a proxy setup where the browser's hostname differs from the request host.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Google OAuth (this app's own flow) --------------------------------------
# The college's own Google OAuth client. Until now Google sign-in went through
# Supabase's hosted flow, which put two things outside our control that have
# both broken sign-in in production: Supabase's redirect-URL allow-list, and
# which Google app owned the consent screen.
#
# Google Cloud Console → APIs & Services → Credentials → your OAuth client →
# Authorised redirect URIs must include, for EVERY domain the app is served on:
#   https://<domain>/th/auth/google/callback
#   http://localhost:59500/th/auth/google/callback
# The /th is fixed on purpose — Google matches redirect_uri exactly, so the
# viewer's real locale travels in a cookie instead of the path (lib/google-oauth.ts).
#
# Supabase → Authentication → Providers → Google must stay ENABLED, with this
# client id listed under "Authorized Client IDs": the app hands Supabase the
# verified Google ID token (signInWithIdToken) and Supabase issues the session,
# so auth.uid() and every RLS policy keep working unchanged.
#
# The id is public (it appears in the authorize URL). The secret is server-only
# and must never be NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
