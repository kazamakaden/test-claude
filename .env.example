# Supabase project (create at https://supabase.com, then fill these in).
# Copy this file to .env.local (git-ignored) and never commit real values.

# Browser + SSR via @supabase/ssr — NEXT_PUBLIC_* is inlined into the client
# bundle at BUILD time, so these must be set before `npm run build`, not just
# `npm run start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never import into a Client Component.
SUPABASE_SECRET_KEY=

# @supabase/server (Edge Functions phase) reads these exact unprefixed names.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Cloudflare Turnstile (login form CAPTCHA). Sitekey is public by design —
# the Secret Key never enters this repo, it's pasted directly into Supabase
# dashboard → Auth → Bot and Abuse Protection. The login form renders no
# widget at all when this is unset (dev fallback, matches the
# isSupabaseConfigured pattern used elsewhere in lib/supabase/env.ts).
#
# For local dev, use one of Cloudflare's documented testing sitekeys instead
# of a real one — no Cloudflare account needed:
#   1x00000000000000000000AA  always passes, visible widget (recommended)
#   1x00000000000000000000BB  always passes, invisible widget
#   2x00000000000000000000AB  always blocks, visible widget
#   2x00000000000000000000BB  always blocks, invisible widget
#   3x00000000000000000000FF  forces an interactive challenge
# NEVER set a test key as the real production value — lib/turnstile.ts's
# assertTurnstileSafeForProduction() throws in production if it detects one
# (or if this is unset), specifically to prevent that.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Fallback for actions/auth.ts's emailRedirectTo/redirectTo when the
# `origin` request header is absent — without it, a missing header produces
# the literal string "null/th/auth/callback" instead of a real URL, and a
# signup/reset email's link goes nowhere. Set to the deployed origin, e.g.
# https://test-claude-swart-delta.vercel.app (no trailing slash).
#
# Can be left blank on Vercel: lib/site-url.ts falls back to Vercel's
# auto-injected VERCEL_PROJECT_PRODUCTION_URL. Only set this by hand for a
# custom domain, if "Automatically expose System Environment Variables" is
# off, or for the self-hosted Linux target (CLAUDE.md §2).
NEXT_PUBLIC_SITE_URL=
